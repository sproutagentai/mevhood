{
  "name": "@mevhood/mevy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ai": "7.0.137",
    "eve": "0.81.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "description": "Mevy: frozen-control experiments for cost-aware MEV research",
  "scripts": {
    "research:llm": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.llm.local --import tsx src/llm-cli.ts",
    "audit:history": "node --env-file-if-exists=.env.local --import tsx src/audit-history.ts",
    "collect": "node --env-file-if-exists=.env.local --import tsx src/collector.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:contracts": "forge test -vv",
    "build:agent": "eve build --skip-sandbox-prewarm",
    "mevy": "node --env-file-if-exists=.env.local --import tsx src/cli.ts",
    "dev": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.llm.local node_modules/eve/bin/eve.js dev",
    "verify": "npm run typecheck && npm test && npm run build:agent",
    "auto:research": "node --import tsx src/auto-runner.ts",
    "auto:publish": "node --import tsx src/publish-runner.ts",
    "lab:verify": "node --import tsx src/lab-cli.ts",
    "lab:audit": "node --import tsx src/lab-audit-cli.ts",
    "fork:verify": "node --import tsx src/fork-study.ts",
    "fork:study": "node --import tsx tools/fork-size-study.ts",
    "frontier:verify": "node --import tsx src/frontier-cli.ts",
    "frontier:audit": "node --import tsx src/frontier-audit-cli.ts"
  }
}
